# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# For Supabase, set DATABASE_URL from Project Settings > Database > Connection string.
# Download the project CA from Database Settings > SSL Configuration and point
# DATABASE_SSL_CA_PATH at it. This keeps certificate and hostname verification
# enabled; do not set DATABASE_SSL=false in production.
DATABASE_URL=
DATABASE_SSL_CA_PATH=./certs/prod-supabase.crt
# For local PostgreSQL, leave DATABASE_URL empty and use these values:


# Supabase Auth & Storage configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_BUCKET_ITEMS=item-images
SUPABASE_BUCKET_CLAIMS=claim-proofs

AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=100
PASSWORD_CHANGE_RATE_LIMIT_MAX=5
# Set true only when your deployment platform strips user-supplied X-Forwarded-For.
TRUST_PROXY=false

# Frontend URL
FRONTEND_URL=http://localhost:5173
